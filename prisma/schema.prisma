// Схема базы сервиса записи в салон.
//
// Prisma 7: клиент генерируется в исходники проекта, а не в node_modules,
// поэтому output обязателен и импортировать нужно оттуда.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// CLIENT | MASTER | ADMIN. Тип String — таким его создаёт Better Auth.
  /// Целостность значений обеспечена CHECK-констрейнтом в миграции.
  role          String?   @default("CLIENT")
  /// Три поля ниже требует плагин admin (auth.api.createUser — им заводит
  /// мастеров админка, без автовхода и без куки новой сессии). Баном
  /// пользователей в проекте не пользуемся, но без полей плагин не встаёт.
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  /// Профиль мастера — только у сотрудников, у клиентов его нет.
  master       Master?
  appointments Appointment[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Тоже требует плагин admin (сессии выданные через impersonateUser).
  /// Функцией не пользуемся, но без поля не встаёт схема.
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────────────────────────────────────────────────
// Предметная область: салон, мастера, услуги, записи
// ───────────────────────────────────────────────────────────────

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

/// Профиль мастера. Отдельно от User: у мастера есть своё
/// (описание, витринное имя), у клиента этого нет.
model Master {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  bio         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  services     MasterService[]
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  appointments Appointment[]

  @@map("master")
}

model Service {
  id           String   @id @default(cuid())
  title        String
  description  String?
  durationMin  Int
  /// В копейках. Дробные типы для денег дают ошибки округления.
  priceKopecks Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  masters      MasterService[]
  appointments Appointment[]

  @@map("service")
}

/// Какой мастер какие услуги выполняет.
/// Без этой связи клиент запишется на окрашивание к мастеру маникюра.
model MasterService {
  masterId  String
  serviceId String
  master    Master  @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([masterId, serviceId])
  @@index([serviceId])
  @@map("master_service")
}

/// Повторяющийся недельный график мастера.
/// Время — минуты от полуночи в часовом поясе салона, не UTC.
model WorkingHours {
  id       String @id @default(cuid())
  masterId String
  master   Master @relation(fields: [masterId], references: [id], onDelete: Cascade)
  /// 0 — воскресенье, 6 — суббота (совпадает с Date.getDay()).
  weekday  Int
  startMin Int
  endMin   Int

  @@unique([masterId, weekday, startMin])
  @@map("working_hours")
}

/// Разовые блокировки: отпуск, обед, «ушёл раньше».
model TimeOff {
  id       String   @id @default(cuid())
  masterId String
  master   Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  reason   String?

  @@index([masterId, startsAt])
  @@map("time_off")
}

model Appointment {
  id        String  @id @default(cuid())
  masterId  String
  clientId  String
  serviceId String
  master    Master  @relation(fields: [masterId], references: [id], onDelete: Cascade)
  client    User    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  /// Timestamptz обязателен: EXCLUDE-констрейнт строится на tstzrange.
  startsAt DateTime          @db.Timestamptz(3)
  /// Хранится явно, а не вычисляется: констрейнт не может заглянуть
  /// в таблицу услуг за длительностью.
  endsAt   DateTime          @db.Timestamptz(3)
  status   AppointmentStatus @default(CONFIRMED)

  /// Копии на момент записи. Если админ поднимет цену стрижки,
  /// выручка за прошлый месяц не должна измениться задним числом.
  priceKopecksAtBooking Int
  durationMinAtBooking  Int

  clientNote String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([masterId, startsAt])
  @@index([clientId, startsAt])
  @@map("appointment")
}
