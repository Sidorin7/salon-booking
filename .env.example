# Скопируйте в .env: cp .env.example .env
# Локальные значения совпадают с docker-compose.yml.

DATABASE_URL="postgresql://salon:salon@localhost:5433/salon?schema=public"

# База для интеграционных тестов: тот же контейнер, отдельная база.
# Тесты её пересоздают и чистят между файлами — рабочую salon не трогают.
TEST_DATABASE_URL="postgresql://salon:salon@localhost:5433/salon_test?schema=public"

# Часовой пояс салона. Все моменты времени в базе хранятся в UTC,
# а рабочие часы задаются в этом поясе. Одно место конвертации.
SALON_TIMEZONE="Europe/Moscow"

# Better Auth. Сгенерировать секрет: openssl rand -base64 32
BETTER_AUTH_SECRET="замените-на-случайную-строку"
BETTER_AUTH_URL="http://localhost:3000"
